<Project Sdk="Microsoft.NET.Sdk">

  <!--
    用戶端測試用的「假群益宿主」。協定層直接連結宿主的 Serve\*.cs(與真宿主同一份程式碼),只把 SKCOM 換成依實測行為模擬的
    FakeSkQuoteSource,所以用戶端測到的協定就是真宿主的協定。它不是測試專案(名稱不以 .Tests 結尾),
    Directory.Build.props 會套用套件等級的嚴格分析;這裡改回測試程式碼該有的寬鬆程度。
    A fake Capital host for the client tests. Its protocol layer links the host's Serve\*.cs (the same code as the real
    host) and only SKCOM is replaced by FakeSkQuoteSource, which simulates the measured behaviour, so the client is
    tested against the real host's protocol. It is not a test project (its name does not end in .Tests), so the
    package-level strict analysis is relaxed here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 只在 Windows 跑(群益與用戶端測試都是 Windows);時區用 Windows ID。Windows only, using Windows time zone ids. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1303;CA1707;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Ozakboy.TradeKit.Capital.Host\Serve\*.cs" Link="Serve\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

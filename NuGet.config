<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    套件來源。
    ozakboy-local 是自研套件 dotnet pack 的落點,開發初期一律走本機 feed,不急著推 nuget.org。
    <clear /> 是刻意的:排除機器層級殘留的來源,確保每台機器還原結果一致。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="ozakboy-local" value="D:\程式專案\Ozakboy_GitHub\nuget-local-feed" />
  </packageSources>

</configuration>
